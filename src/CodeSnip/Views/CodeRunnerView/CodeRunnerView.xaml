<UserControl x:Class="CodeSnip.Views.CodeRunnerView.CodeRunnerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CodeSnip.Views.CodeRunnerView"
             xmlns:behaviors="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" 
             xmlns:helpers="clr-namespace:CodeSnip.Helpers"
             d:DataContext="{d:DesignInstance Type=local:CodeRunnerViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="400" >
    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <mah:MetroProgressBar Height="10" IsIndeterminate="True" Grid.Row="0">
            <mah:MetroProgressBar.Style>
                <Style TargetType="mah:MetroProgressBar" BasedOn="{StaticResource {x:Type mah:MetroProgressBar}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </mah:MetroProgressBar.Style>
        </mah:MetroProgressBar>
        <Grid Grid.Row="1" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition  Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Compiler:" FontWeight="Bold" Grid.Column="0" Grid.Row="0"/>
            <ComboBox ItemsSource="{Binding Compilers}"
                        SelectedItem="{Binding SelectedCompiler}"
                        DisplayMemberPath="Name" Grid.Column="0" Grid.Row="1" Width="120" IsTabStop="False"/>
            <TextBlock Text="Compiler flags:" FontWeight="Bold" Margin="10,0,0,0" Grid.Column="1" Grid.Row="0" />
            <TextBox  Text="{Binding Flags}" Grid.Column="1" Grid.Row="1" Margin="10,0,0,0" TabIndex="3"/>
        </Grid>
        <Grid  Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Button Content="Run" Command="{Binding RunCommand}" Grid.Column="0" Grid.Row="0" TabIndex="0"/>
            <mah:Badged Badge="{Binding ReloadBadge}" Grid.Column="1" Grid.Row="0" Margin="10,0,0,0" >
                <Button Content="Reload" TabIndex="1"           
                        Command="{Binding ReloadCommand}" />
            </mah:Badged>
            <Button Content="Get link"  Margin="10,0,0,0" Grid.Column="2" Grid.Row="0" TabIndex="2" Command="{Binding GetLinkCommand}"/>
            <TextBox Grid.Column="3" Grid.Row="0" Margin="10,0,0,0" IsReadOnly="True" Text="{Binding ShortLink}" />
        </Grid>
        <mah:ToggleSwitch IsOn="{Binding ShowAsm, Mode=TwoWay}" Grid.Row="3" Margin="0,10,0,0" Content="Show assembler output"
                          Style="{DynamicResource MahApps.Styles.ToggleSwitch.Metro}">
        </mah:ToggleSwitch>
        <mah:MetroTabControl Grid.Row="4" Margin="0,10,0,0"
                                Style="{DynamicResource MahApps.Styles.TabControl.Animated}" mah:HeaderedControlHelper.HeaderFontSize="18">
            <mah:MetroTabItem Header="Output">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Expander Header="Stdout:" IsExpanded="{Binding HasOut}" Grid.Row="0">
                        <Expander.Resources>
                            <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource SimpleExpander}" />
                        </Expander.Resources>
                        <TextBox Text="{Binding StdOut}" IsReadOnly="True" 
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </Expander>
                    <Expander Header="Stderr:" IsExpanded="{Binding HasError}" Grid.Row="1">
                        <Expander.Resources>
                            <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource SimpleExpander}" />
                        </Expander.Resources>
                        <TextBox Text="{Binding ErrorText}" IsReadOnly="True" Foreground="#FFF92672" Margin="0,0,0,2"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </Expander>
                </Grid>
            </mah:MetroTabItem>

            <mah:MetroTabItem Header="Assembler">
                <avalonEdit:TextEditor
                    x:Name="asmEditor"
                    FontFamily="Consolas"
                    IsReadOnly="True"
                    ShowLineNumbers="True"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    Margin="5" >
                    <behaviors:Interaction.Behaviors>
                        <helpers:AvalonEditTextBindingBehavior BoundText="{Binding AsmCode, Mode=OneWay}" />
                        <helpers:AvalonEditHighlightingBehavior HighlightingName="{Binding AsmHighlightingName}" />
                    </behaviors:Interaction.Behaviors>
                    <avalonEdit:TextEditor.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Command="ApplicationCommands.Copy" />
                            <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll" />
                        </ContextMenu>
                    </avalonEdit:TextEditor.ContextMenu>

                </avalonEdit:TextEditor>
            </mah:MetroTabItem>
        </mah:MetroTabControl>
    </Grid>
</UserControl>
