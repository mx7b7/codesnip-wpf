<UserControl x:Class="CodeSnip.Views.CodeRunnerView.CodeRunnerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CodeSnip.Views.CodeRunnerView"
             xmlns:behaviors="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" 
             xmlns:helpers="clr-namespace:CodeSnip.Helpers"
             d:DataContext="{d:DesignInstance Type=local:CodeRunnerViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="400" >
    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="CustomChromelessButton" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Chromeless}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter Name="PART_ContentPresenter"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Opacity=".75"
                                      RecognizesAccessKey="{TemplateBinding mah:ControlsHelper.RecognizesAccessKey}"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_ContentPresenter" Property="Opacity" Value=".5" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="PART_ContentPresenter" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#ADADAD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- Progress bar -->
            <RowDefinition Height="10"/>
            <!-- Compiler selection and flags -->
            <RowDefinition Height="Auto"/>
            <!-- Short link -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
            <RowDefinition Height="Auto"/>
            <!-- Tab control -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Progress bar row 0 -->
        <mah:MetroProgressBar Height="10" IsIndeterminate="True" Grid.Row="0">
            <mah:MetroProgressBar.Style>
                <Style TargetType="mah:MetroProgressBar" BasedOn="{StaticResource {x:Type mah:MetroProgressBar}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </mah:MetroProgressBar.Style>
        </mah:MetroProgressBar>
        <!-- Compiler selection and flags row 1 -->
        <Grid Grid.Row="1" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition  Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Compiler:" FontWeight="Bold" Grid.Column="0" Grid.Row="0"/>
            <ComboBox ItemsSource="{Binding Compilers}"
                        SelectedItem="{Binding SelectedCompiler}"
                        DisplayMemberPath="Name" Grid.Column="0" Grid.Row="1" Width="120" IsTabStop="False"/>
            <TextBlock Text="Compiler flags:" FontWeight="Bold" Margin="10,0,0,0" Grid.Column="1" Grid.Row="0" />
            <TextBox  Text="{Binding Flags}" Grid.Column="1" Grid.Row="1" Margin="10,0,0,0" />
        </Grid>
        <!-- Short link row 2-->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Short link" Grid.Column="0" Grid.Row="0" Command="{Binding GetLinkCommand}"/>
            <TextBox Grid.Column="1" Grid.Row="0" Margin="10,0,0,0" IsReadOnly="True" Text="{Binding ShortLink}" 
             mah:TextBoxHelper.ButtonCommand="{Binding NavigateToLinkCommand}"
             Style="{DynamicResource MahApps.Styles.TextBox.Button}">
                <mah:TextBoxHelper.ButtonContent>
                    <Path Data="{StaticResource CompilerExplorer}" Fill="{DynamicResource MahApps.Brushes.AccentBase}" Width="16" Height="16" 
                          Stretch="Uniform" ToolTip="Open in Web Browser"
                          ToolTipService.InitialShowDelay="300"
                          ToolTipService.ShowDuration="3000"
                          ToolTipService.BetweenShowDelay="100">
                    </Path>
                </mah:TextBoxHelper.ButtonContent>
            </TextBox>
        </Grid>
        <!-- Buttons row 3-->
        <Grid  Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>
            <Button Content="Run" Command="{Binding RunCommand}" Grid.Column="0" Grid.Row="0" TabIndex="0"/>
            <Button Content="Run Local" Grid.Column="1" Margin="10,0,0,0" Grid.Row="0" TabIndex="1" Command="{Binding RunLocalCommand}"/>
            <Button Grid.Column="2" Margin="10,0,0,0" Grid.Row="0"
                    ToolTip="Kill running process"
                    ToolTipService.InitialShowDelay="300"
                    ToolTipService.ShowDuration="3000"
                    ToolTipService.BetweenShowDelay="100"
                    Command="{Binding KillRunningProcessCommand}"
                    Style="{StaticResource CustomChromelessButton}">
                <Path Data="{StaticResource TerminalX}" Fill="{DynamicResource MahApps.Brushes.Accent}" Stretch="Uniform" />
            </Button>
            <mah:Badged Badge="{Binding ReloadBadge}" Grid.Column="3" Grid.Row="0" Margin="10,0,0,0" >
                <Button TabIndex="2" Command="{Binding ReloadCommand}"
                        ToolTip="Reload snipppet code"
                        ToolTipService.InitialShowDelay="300"
                        ToolTipService.ShowDuration="3000"
                        ToolTipService.BetweenShowDelay="100"
                        Style="{StaticResource CustomChromelessButton}">
                    <Path Data="{StaticResource Reload}" Fill="{DynamicResource MahApps.Brushes.Accent}" Stretch="Uniform" />
                </Button>
            </mah:Badged>
            <mah:ToggleSwitch IsOn="{Binding ShowAsm, Mode=TwoWay}" Grid.Row="0" Grid.Column="4" Margin="10,0,0,0" Content="Show ASM output"
                              Style="{DynamicResource MahApps.Styles.ToggleSwitch.Metro}" VerticalAlignment="Center">
            </mah:ToggleSwitch>
        </Grid>
        <!-- Tab control row 4 -->
        <mah:MetroTabControl Grid.Row="4" Margin="0,10,0,0"
                                Style="{DynamicResource MahApps.Styles.TabControl.Animated}" mah:HeaderedControlHelper.HeaderFontSize="18">
            <mah:MetroTabItem Header="Output">
                <!--<ScrollViewer VerticalScrollBarVisibility="Auto">-->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Expander Header="Stdout:" IsExpanded="{Binding HasOut}" Grid.Row="0" Padding="0">
                        <Expander.Resources>
                            <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource SimpleExpander}" />
                        </Expander.Resources>
                        <TextBox Text="{Binding StdOut}" IsReadOnly="True" BorderThickness="0.5"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy" Command="ApplicationCommands.Copy" />
                                    <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll" />
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>
                    </Expander>
                    <Expander Header="Stderr:" IsExpanded="{Binding HasError}" Grid.Row="1" Padding="0">
                        <Expander.Resources>
                            <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource SimpleExpander}" />
                        </Expander.Resources>
                        <TextBox Text="{Binding ErrorText}" IsReadOnly="True" Foreground="#FFF92672" Margin="0,0,0,2" MaxHeight="300"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0.5">
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy" Command="ApplicationCommands.Copy" />
                                    <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll" />
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>
                    </Expander>
                </Grid>
                <!--</ScrollViewer>-->
            </mah:MetroTabItem>

            <mah:MetroTabItem Header="Assembler">
                <avalonEdit:TextEditor
                    x:Name="asmEditor"
                    FontFamily="Consolas"
                    IsReadOnly="True"
                    ShowLineNumbers="True"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    Margin="5" >
                    <behaviors:Interaction.Behaviors>
                        <helpers:AvalonEditTextBindingBehavior BoundText="{Binding AsmCode, Mode=OneWay}" />
                        <helpers:AvalonEditHighlightingBehavior HighlightingName="{Binding AsmHighlightingName}" />
                    </behaviors:Interaction.Behaviors>
                    <avalonEdit:TextEditor.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Command="ApplicationCommands.Copy" />
                            <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll" />
                        </ContextMenu>
                    </avalonEdit:TextEditor.ContextMenu>

                </avalonEdit:TextEditor>
            </mah:MetroTabItem>
        </mah:MetroTabControl>
    </Grid>
</UserControl>
