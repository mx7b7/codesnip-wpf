                            <Grid x:Name="DbStatusGrid">
                                <ToggleButton x:Name="DbStatusButton"
                                          IsEnabled="{Binding IsDatabaseAlertActive}"
                                          Style="{StaticResource MahApps.Styles.Button.Chromeless}"
