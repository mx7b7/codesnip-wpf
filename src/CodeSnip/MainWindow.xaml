                                          ToolTipService.ShowDuration="3000"
                                          ToolTipService.BetweenShowDelay="100" >
                                    <Path Fill="{DynamicResource MahApps.Brushes.Text}" Data="{StaticResource DatabaseAlert}" Width="16" Height="16" Stretch="Uniform" />
