<mah:MetroWindow
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:behaviors="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
        xmlns:helpers="clr-namespace:CodeSnip.Helpers"
        xmlns:local="clr-namespace:CodeSnip"
        xmlns:settingsView="clr-namespace:CodeSnip.Views.SettingsView"
        xmlns:langCatView="clr-namespace:CodeSnip.Views.LanguageCategoryView"
        xmlns:snippetView="clr-namespace:CodeSnip.Views.SnippetView"
        xmlns:codeRunnerView="clr-namespace:CodeSnip.Views.CodeRunnerView"
        xmlns:compilerSettingsView="clr-namespace:CodeSnip.Views.CompilerSettingsView"
        xmlns:highlightingEditorView="clr-namespace:CodeSnip.Views.HighlightingEditorView"
        xmlns:controlzex="urn:controlzex"
        xmlns:notifications="clr-namespace:Notifications.Wpf.Core.Controls;assembly=Notifications.Wpf.Core"
        x:Class="CodeSnip.MainWindow"
        d:DataContext="{d:DesignInstance Type={x:Type local:MainViewModel}}"
        mc:Ignorable="d"
		d:Width="400" d:Height="400" 
        MinWidth="600" 
        MinHeight="400"  
        ResizeMode="CanResizeWithGrip"
        TitleAlignment="Left"
        TitleCharacterCasing="Normal"
        Title ="{Binding WindowTitle}" 
        Left="{Binding WindowX, Mode=TwoWay}" 
        Top="{Binding WindowY, Mode=TwoWay}" 
        Width="{Binding WindowWidth, Mode=TwoWay}" 
        Height="{Binding WindowHeight, Mode=TwoWay}" 
        WindowState="{Binding WindowState, Mode=TwoWay}" 
	    Style="{DynamicResource MahApps.Styles.MetroWindow.Clean}" 
        IconTemplate="{StaticResource AppIconTemplate}"
        Closing="MetroWindow_Closing" >
    <!--WindowButtonCommandsOverlayBehavior="Never"-->
    <mah:MetroWindow.Resources>
        <helpers:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <helpers:StringToFontWeightConverter x:Key="StringToFontWeightConverter" />
        <helpers:LanguageToVisibilityConverter x:Key="LanguageToVisibilityConverter" />
        <!-- ........................................................................... -->
        <DataTemplate DataType="{x:Type settingsView:SettingsViewModel}">
            <settingsView:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type codeRunnerView:CodeRunnerViewModel}">
            <codeRunnerView:CodeRunnerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type snippetView:SnippetViewModel}">
            <snippetView:SnippetView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type langCatView:LanguageCategoryViewModel}">
            <langCatView:LanguageCategoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type compilerSettingsView:CompilerSettingsViewModel}">
            <compilerSettingsView:CompilerSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type highlightingEditorView:HighlightingEditorViewModel}">
            <highlightingEditorView:HighlightingEditorView />
        </DataTemplate>
        <!-- Custom button style with opacity changes on hover -->
        <Style x:Key="CustomChromelessButton" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Chromeless}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter Name="PART_ContentPresenter"
                              Margin="10,0,10,0"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Opacity=".75"
                              RecognizesAccessKey="{TemplateBinding mah:ControlsHelper.RecognizesAccessKey}"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_ContentPresenter" Property="Opacity" Value=".5" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="PART_ContentPresenter" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#ADADAD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Custom button style for WindowCommands suitable for Clean theme (light/dark titlebar), for accent titlebar use default style. -->
        <Style x:Key="CustomTitlebarButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.MetroWindow.Base}">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Margin" Value="8,0,8,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.5" />
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </mah:MetroWindow.Resources>

    <mah:MetroWindow.InputBindings>
        <!-- F1 : Open About dialog -->
        <KeyBinding Key="F1" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=OpenAboutCommand}" />
        <!-- F2 : Theme switch -->
        <KeyBinding Key="F2" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ThemeSwitchCommand}" />
        <!-- Ctrl + S : Save snippet code -->
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCodeCommand}"/>
        <!-- Ctrll+Shift + A : Add new snippet -->
        <KeyBinding Key="A" Modifiers="Ctrl+Shift" Command="{Binding AddSnippetCommand}"/>
        <!-- Ctrll+Shift + E : Edit current cnippet metadata -->
        <KeyBinding Key="E" Modifiers="Ctrl+Shift" Command="{Binding EditSnippetCommand}"/>
        <!-- Ctrll+Shift + D : Delete current snippet -->
        <KeyBinding Key="D" Modifiers="Ctrl+Shift" Command="{Binding DeleteSnippetCommand}"/>
        <!-- Ctrll+Shift + L : Open Language/Category management -->
        <KeyBinding Key="L" Modifiers="Ctrl+Shift" Command="{Binding OpenLanguageCategoryCommand}"/>
        <!-- Ctrll+Shift + P : Open application settings -->
        <KeyBinding Key="P" Modifiers="Ctrl+Shift" Command="{Binding OpenSettingsCommand}"/>
        <!-- Ctrll+Shift + R : Open Code Runner window -->
        <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{Binding OpenCodeRunnerViewCommand}"/>
        <!-- Ctrll+Shift + H : Open Highlighting editor -->
        <KeyBinding Key="H" Modifiers="Ctrl+Shift" Command="{Binding OpenHighlightingEditorCommand}"/>

        <!-- Ctrl + K : Toggle Single-Line Comment -->
        <KeyBinding Key="K" Modifiers="Ctrl"
                Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ToggleSingleLineCommentCommand}" />

        <!-- Ctrl + Shift + K : Toggle Multi-Line Comment -->
        <KeyBinding Key="K" Modifiers="Ctrl+Shift"
                Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ToggleMultiLineCommentCommand}" />

        <!-- Ctrl + Shift + I : Toggle Inline Block Comment -->
        <KeyBinding Key="I" Modifiers="Ctrl+Shift"
                Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ToggleCommentSelectionCommand}" />

        <!-- Ctrl + Shift + F : Format All  -->
        <KeyBinding Key="F" Modifiers="Ctrl+Shift"
                Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FormatAllCommand}" />

        <!-- Zoom In -->
        <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{Binding IncreaseFontSizeCommand}"/>
        <!-- Zoom Out -->
        <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding DecreaseFontSizeCommand}"/>
        <!-- Reset Zoom -->
        <KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding ResetFontSizeCommand}"/>
    </mah:MetroWindow.InputBindings>

    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>
            <mah:WindowCommands.Resources>

            </mah:WindowCommands.Resources>
            <Button Style="{StaticResource CustomTitlebarButtonStyle}" Click="About_Click" ToolTip="About&#xA;F1">
                <Path Data="{StaticResource InfoCircle}" Fill="{DynamicResource MahApps.Brushes.Accent}"
                      Width="20" Height="20" Stretch="Uniform">
                    <Path.LayoutTransform>
                        <ScaleTransform ScaleY="-1"/>
                    </Path.LayoutTransform>
                </Path>
            </Button>
            <Button Style="{StaticResource CustomTitlebarButtonStyle}" ToolTip="Theme switch&#xA;F2" Click="ThemeSwitch_Click">
                <Path Data="{StaticResource ThemeLightDark}" Fill="{DynamicResource MahApps.Brushes.Accent}"
                      Width="20" Height="20" Stretch="Uniform" >
                </Path>
            </Button>
            <Button Style="{StaticResource CustomTitlebarButtonStyle}" 
                    Command="{Binding PickColorCommand}"
                    ToolTip="Pick accent color">
                <Path Data="{StaticResource ColorPaletteiOS}" Fill="{DynamicResource MahApps.Brushes.Accent}"
                      Width="20" Height="20" Stretch="Uniform" />
            </Button>
            <StackPanel>
                <mah:ColorPicker SelectedColor="{Binding SelectedAccentColor, Mode=TwoWay}" 
                                 IsDropDownOpen="{Binding IsColorPickerOpen, Mode=TwoWay}"
                                 Width="1" Visibility="Hidden" >
                </mah:ColorPicker>
            </StackPanel>
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>

    <mah:MetroWindow.Flyouts>
        <mah:FlyoutsControl x:Name="flyControl"/>
    </mah:MetroWindow.Flyouts>
    <Grid Margin="0,2,0,0">
        <mah:SplitView x:Name="SplitViewControl"
               DisplayMode="CompactInline"
               CompactPaneLength="0"
               OpenPaneLength="{Binding SplitViewOpenPaneLength, Mode=TwoWay}"
               IsPaneOpen="{Binding IsPaneOpen, Mode=TwoWay}"
               PaneBackground="{x:Null}" CanResizeOpenPane="True" MaximumOpenPaneLength="600">
            <mah:SplitView.Pane>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Search expander -->
                        <RowDefinition Height="*"/>
                        <!-- Snippets expander -->
                    </Grid.RowDefinitions>
                    <Expander Header="Search" Grid.Row="0" IsExpanded="{Binding IsSearchExpanded, Mode=TwoWay}"
                               mah:HeaderedControlHelper.HeaderFontWeight="Medium" mah:HeaderedControlHelper.HeaderFontSize="14" BorderThickness="1,2,2,1" >
                        <Expander.Resources>
                            <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource SimpleExpander}">
                                <Setter Property="mah:HeaderedControlHelper.HeaderForeground" Value="{DynamicResource MahApps.Brushes.AccentBase}" />
                            </Style>
                        </Expander.Resources>
                        <Grid Margin="0,5,0,5" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <!-- RadioButton "by Name" -->
                                <ColumnDefinition Width="Auto" />
                                <!-- RadioButton "by Tag" -->
                                <ColumnDefinition Width="10" />
                                <!-- Razmak -->
                                <ColumnDefinition Width="*" />
                                <!-- TextBox za filter -->
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="rbName" Content="Name" GroupName="FilterMode"
                                        Grid.Column="0" VerticalAlignment="Center" ToolTip="Search by Name"
                                        IsChecked="{Binding FilterMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Name}" />
                            <RadioButton x:Name="rbTag" Content="Tag" Grid.Column="1" Margin="10,0,0,0"  GroupName="FilterMode"
                                         VerticalAlignment="Center"  ToolTip="Search by Tag"
                                        IsChecked="{Binding FilterMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Tag}" />
                            <TextBox x:Name="txtFilter" mah:TextBoxHelper.Watermark="Search snippets..."
                                     VerticalAlignment="Center"
                                     mah:ControlsHelper.CornerRadius="12"
                                     Padding="8,4"
                                     Grid.Column="3"
                                     BorderThickness=".5"
                                     IsEnabled="{Binding IsFilteringEnabled, Mode=TwoWay}"
                                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Filter by multiple words: word1 word2... (partial matches work)"/>
                        </Grid>
                    </Expander>
                    <Expander Header="Snippets" Grid.Row="1" IsExpanded="{Binding IsSnippetsExpanded, Mode=TwoWay}" 
                              mah:HeaderedControlHelper.HeaderFontWeight="Medium" mah:HeaderedControlHelper.HeaderFontSize="14"
                              BorderThickness="1,1,2,2" Padding="0">
                        <Expander.Resources>
                            <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource SimpleExpander}">
                                <Setter Property="mah:HeaderedControlHelper.HeaderForeground" Value="{DynamicResource MahApps.Brushes.AccentBase}" />
                            </Style>
                        </Expander.Resources>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <!-- TreeView -->
                                <RowDefinition Height="Auto"/>
                                <!-- Snippets metadata expander -->
                            </Grid.RowDefinitions>
                            <TreeView x:Name="treeSnippets"  Grid.Row="0"
                                 ItemsSource="{Binding Languages}"
                                 SelectedItemChanged="TreeView_SelectedItemChanged">
                                <TreeView.Resources>
                                    <PathGeometry x:Key="LanguageIcon">M15.25,13H17.25L16.75,15H14.75L15.25,13M22,8V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H20A2,2 0 0,1 22,8M20,12H18.5L19,10H18L17.5,12H15.5L16,10H15L14.5,12H13V13H14.25L13.75,15H12V16H13.5L13,18H14L14.5,16H16.5L16,18H17L17.5,16H19V15H17.75L18.25,13H20V12Z</PathGeometry>
                                    <Geometry x:Key="CategoryIcon">M3,6h18v2H3V6zm0,5h18v2H3v-2zm0,5h18v2H3v-2z</Geometry>
                                    <Geometry x:Key="SnippetIcon">M5,4h14a2,2 0 0 1 2,2v12a2,2 0 0 1 -2,2H5a2,2 0 0 1 -2,-2V6a2,2 0 0 1 2,-2zm0,2v12h14V6H5zm2,2h10v2H7V8zm0,4h6v2H7v-2z</Geometry>
                                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource TreeViewScrollBar}" />
                                </TreeView.Resources>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <!-- LANGUAGE -->
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Categories}">
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <Path Data="{StaticResource LanguageIcon}" Fill="{DynamicResource MahApps.Brushes.AccentBase}" Width="24" Height="24" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       FontSize="{Binding DataContext.LanguageFontSize, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                                       FontWeight="{Binding DataContext.LanguageFontWeight, RelativeSource={RelativeSource AncestorType=TreeView}, Converter={StaticResource StringToFontWeightConverter}}"/>
                                        </StackPanel>
                                        <!-- CATEGORY -->
                                        <HierarchicalDataTemplate.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Snippets}">
                                                <StackPanel Orientation="Horizontal" Margin="2">
                                                    <Path Data="{StaticResource CategoryIcon}" Fill="{DynamicResource MahApps.Brushes.AccentBase}" Width="22" Height="22" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                               FontSize="{Binding DataContext.CategoryFontSize, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                                               FontWeight="{Binding DataContext.CategoryFontWeight, RelativeSource={RelativeSource AncestorType=TreeView}, Converter={StaticResource StringToFontWeightConverter}}"/>
                                                </StackPanel>
                                                <!-- SNIPPET -->
                                                <HierarchicalDataTemplate.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="2">
                                                            <Path x:Name="SnippetIconPath" Data="{StaticResource SnippetIcon}" Fill="{DynamicResource MahApps.Brushes.AccentBase}" Width="22" Height="22" Margin="0,0,5,0">
                                                                <Path.RenderTransform>
                                                                    <TransformGroup>
                                                                        <ScaleTransform ScaleY="0.8" ScaleX="1.0"/>
                                                                        <TranslateTransform Y="1.5"/>

                                                                    </TransformGroup>
                                                                </Path.RenderTransform>
                                                            </Path>
                                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                                       FontSize="{Binding DataContext.SnippetFontSize, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                                                       FontWeight="{Binding DataContext.SnippetFontWeight, RelativeSource={RelativeSource AncestorType=TreeView}, Converter={StaticResource StringToFontWeightConverter}}"/>
                                                        </StackPanel>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                                                <Setter TargetName="SnippetIconPath" Property="Fill" Value="{DynamicResource MahApps.Brushes.Text}"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </HierarchicalDataTemplate.ItemTemplate>
                                            </HierarchicalDataTemplate>
                                        </HierarchicalDataTemplate.ItemTemplate>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                                <TreeView.ContextMenu>
                                    <ContextMenu FontSize="12">
                                        <MenuItem Header="Add Snippet" Command="{Binding AddSnippetCommand}">
                                            <MenuItem.Icon>
                                                <Path Data="{StaticResource FileAdd}" Fill="{DynamicResource MahApps.Brushes.AccentBase}"
                                                  Width="16" Height="16" Stretch="Uniform" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Edit Snippet" Command="{Binding EditSnippetCommand}">
                                            <MenuItem.Icon>
                                                <Path Data="{StaticResource FileEdit}" Fill="{DynamicResource MahApps.Brushes.AccentBase}"
                                                  Width="16" Height="16" Stretch="Uniform" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Delete Snippet" Command="{Binding DeleteSnippetCommand}">
                                            <MenuItem.Icon>
                                                <Path Data="{StaticResource Trash}" Fill="{DynamicResource MahApps.Brushes.AccentBase}"
                                                  Width="16" Height="16" Stretch="Uniform" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Edit LangCat" Command="{Binding OpenLanguageCategoryCommand}">
                                            <MenuItem.Icon>
                                                <Path Data="{StaticResource CategoryEdit}" Fill="{DynamicResource MahApps.Brushes.AccentBase}"
                                                  Width="16" Height="16" Stretch="Uniform" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                            </TreeView>
                            <!-- Controls below the TreeView -->
                            <Expander Header="Snippet Metadata" Grid.Row="1" Margin="0,10,0,0"
                                      IsExpanded="{Binding IsSnippetMetadataExpanded, Mode=TwoWay}"
                                       mah:HeaderedControlHelper.HeaderFontWeight="Normal" Padding="0">
                                <Expander.Resources>
                                    <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource SimpleExpander}">
                                        <Setter Property="BorderThickness" Value="0.5" />
                                    </Style>
                                </Expander.Resources>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <!-- Description label -->
                                        <RowDefinition Height="*"/>
                                        <!-- Description TextBox  -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Tag Label -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Tag TextBox -->
                                    </Grid.RowDefinitions>
                                    <!-- Description label -->
                                    <TextBlock Text="Description:" Margin="0,0,0,5" Grid.Row="0" />
                                    <!-- Description TextBox that stretches-->
                                    <TextBox x:Name="txtDescription" Grid.Row="1" TextWrapping="Wrap"  Focusable="False"
                                             VerticalScrollBarVisibility="Auto"  Height="100" IsReadOnly="True" BorderThickness="0.5"
                                             Text="{Binding SelectedSnippet.Description}" />
                                    <!-- Tag label -->
                                    <TextBlock Text="Tags:" Margin="0,5,0,5" Grid.Row="2" />
                                    <!-- Tag TextBox -->
                                    <TextBox x:Name="txtTag" Grid.Row="3" Text="{Binding SelectedSnippet.Tag}"
                                             IsReadOnly="True" Focusable="False" BorderThickness="0.5"/>
                                </Grid>
                            </Expander>
                        </Grid>
                    </Expander>
                </Grid>
            </mah:SplitView.Pane>
            <mah:SplitView.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!-- Toolbar -->
                        <RowDefinition Height="*" />
                        <!-- AvalonEdit -->
                        <RowDefinition Height="Auto" />
                        <!-- Status bar -->
                    </Grid.RowDefinitions>
                    <ToolBarTray Grid.Row="0">
                        <ToolBar x:Name="toolbarMain" Height="40">
                            <Button Command="{Binding TogglePanelCommand}" ToolTip="Collapse/Expand"
                                    Style="{StaticResource CustomChromelessButton}">
                                <Path Data="{Binding OpenCloseIcon}" Fill="{DynamicResource MahApps.Brushes.AccentBase}"
                                      Width="22" Height="22" Stretch="Uniform" />
                            </Button>
                            <Button  Command="{Binding SaveCodeCommand}" ToolTip="Save snippet&#xA;Ctrl+S"
                                     Style="{StaticResource CustomChromelessButton}">
                                <Path Data="{StaticResource Save}" Fill="{DynamicResource MahApps.Brushes.AccentBase}"
                                      Width="22" Height="22" Stretch="Uniform" />
                            </Button>
                            <Button  Command="{Binding AddSnippetCommand}" ToolTip="Add snippet&#xA;Ctrl+Shift+A"
                                     Style="{StaticResource CustomChromelessButton}">
                                <Path Data="{StaticResource FileAdd}" Fill="{DynamicResource MahApps.Brushes.AccentBase}"
                                      Width="22" Height="22" Stretch="Uniform" />
                            </Button>
                            <Button  Command="{Binding EditSnippetCommand}" ToolTip="Edit snippet&#xA;Ctrl+Shift+E"
                                     Style="{StaticResource CustomChromelessButton}">
                                <Path Data="{StaticResource FileEdit}" Fill="{DynamicResource MahApps.Brushes.AccentBase}"
                                      Width="22" Height="22" Stretch="Uniform" />
                            </Button>
                            <Button  Command="{Binding DeleteSnippetCommand}" ToolTip="Delete snippet&#xA;Ctrl+Shift+D"
                                     Style="{StaticResource CustomChromelessButton}">
                                <Path Data="{StaticResource Trash}" Fill="{DynamicResource MahApps.Brushes.AccentBase}"
                                      Width="22" Height="22" Stretch="Uniform" />
                            </Button>
                            <Button x:Name="btnLangCat" Command="{Binding OpenLanguageCategoryCommand}"
                                    Style="{StaticResource CustomChromelessButton}"
                                    ToolTip="Language/Category edit&#xA;Ctrl+Shift+L"
                                    IsEnabled="{Binding IsLoadSnippetEnabled, Converter={StaticResource InverseBooleanConverter}}">
                                <Path Data="{StaticResource CategoryEdit}" Fill="{DynamicResource MahApps.Brushes.AccentBase}"
                                      Width="22" Height="22" Stretch="Uniform">
                                    <Path.LayoutTransform>
                                        <ScaleTransform ScaleY="-1"/>
                                    </Path.LayoutTransform>
                                </Path>
                            </Button>
                            <Button ToolTip="Load snippets" IsEnabled="{Binding IsLoadSnippetEnabled}"
                                    Style="{StaticResource CustomChromelessButton}"
                                Command="{Binding LoadSnippetsDatabaseCommand}">
                                <Path Data="{StaticResource DatabaseRefresh}" Fill="{DynamicResource MahApps.Brushes.AccentBase}"
                                      Width="22" Height="22" Stretch="Uniform" />
                            </Button>
                            <Separator />
                            <Button ToolTip="Run&#xA;Ctrl+Shift+R"
                                    Style="{StaticResource CustomChromelessButton}"
                                    Command="{Binding OpenCodeRunnerViewCommand}" >
                                <Path Data="{StaticResource DebugStart}" Fill="{DynamicResource MahApps.Brushes.AccentBase}"
                                      Width="22" Height="22" Stretch="Uniform" />
                            </Button>
                            <Button ToolTip="Compiler explorer settings" 
                                    Style="{StaticResource CustomChromelessButton}"
                                Command="{Binding OpenCompilerSettingsCommand}">
                                <Path Data="{StaticResource CompilerExplorer}" Fill="{DynamicResource MahApps.Brushes.AccentBase}"
                                      Width="22" Height="22" Stretch="Uniform" />
                            </Button>
                            <Separator />
                            <Button Command="{Binding IncreaseFontSizeCommand}" ToolTip="Zoom In&#xA;Ctrl++"
                                    Style="{StaticResource CustomChromelessButton}">
                                <Path Data="{StaticResource ZoomIn}" Fill="{DynamicResource MahApps.Brushes.AccentBase}"
                                  Width="20" Height="20" Stretch="Uniform" />
                            </Button>
                            <Button Command="{Binding DecreaseFontSizeCommand}" ToolTip="Zoom Out&#xA;Ctrl+-"
                                    Style="{StaticResource CustomChromelessButton}">
                                <Path Data="{StaticResource ZoomOut}" Fill="{DynamicResource MahApps.Brushes.AccentBase}"
                                      Width="22" Height="22" Stretch="Uniform" />
                            </Button>
                            <Button Command="{Binding ResetFontSizeCommand}" ToolTip="Reset Zoom&#xA;Ctrl+0"
                                    Style="{StaticResource CustomChromelessButton}">
                                <Path Data="{StaticResource ZoomOutMap}" Fill="{DynamicResource MahApps.Brushes.AccentBase}"
                                      Width="22" Height="22" Stretch="Uniform">
                                    <Path.LayoutTransform>
                                        <ScaleTransform ScaleY="-1"/>
                                    </Path.LayoutTransform>
                                </Path>
                            </Button>
                            <Button ToolTip="Search Ctrl+F&#xA;Replace Ctrl+H"  Command="{Binding OpenSearchReplaceCommand}"
                                    Style="{StaticResource CustomChromelessButton}">
                                <Path Data="{StaticResource TextSearch}" Fill="{DynamicResource MahApps.Brushes.AccentBase}"
                                      Width="22" Height="22" Stretch="Uniform" />
                            </Button>
                            <Button ToolTip="Format code&#xA;Ctrl+Shift+F" Click="FormatAll_Click"
                                    Style="{StaticResource CustomChromelessButton}">
                                <Path Data="{StaticResource FormatText}" Fill="{DynamicResource MahApps.Brushes.AccentBase}"
                                      Width="22" Height="22" Stretch="Uniform" />
                            </Button>
                            <ToggleButton ToolTip="Disable intendation" IsChecked="{Binding DisableIntendation, Mode=TwoWay}">
                                <Path Data="{StaticResource FormatIndentDecrease}" Fill="{DynamicResource MahApps.Brushes.AccentBase}"
                                      Width="22" Height="22" Stretch="Uniform" />
                            </ToggleButton>
                            <Separator />
                            <Button ToolTip="Highlighting Editor&#xA;Ctrl+Shift+H" Command="{Binding OpenHighlightingEditorCommand}"
                                    Style="{StaticResource CustomChromelessButton}">
