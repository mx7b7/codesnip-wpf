<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro">
    <Style x:Key="SimpleExpander"
           TargetType="{x:Type Expander}"
           BasedOn="{StaticResource MahApps.Styles.Expander}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="mah:HeaderedControlHelper.HeaderBackground" Value="Transparent" />
        <Setter Property="mah:HeaderedControlHelper.HeaderForeground" Value="{StaticResource MahApps.Brushes.Gray3}" />
        <!--<Setter Property="mah:ControlsHelper.ContentCharacterCasing" Value="Normal" />-->
        <Setter Property="mah:ExpanderHelper.HeaderDownStyle" Value="{DynamicResource ExpanderDownHeader}" />
    </Style>

</ResourceDictionary>